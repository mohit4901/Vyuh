# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/

# Environment variables & secrets
.env
.env.local
.env.*.local


# Node modules
node_modules/
backend/node_modules/

# Data files (too large for git)
data/raw/
data/processed/
*.csv
*.joblib
!data/graphs/*.json

# Ignore generic pkl files (data, caches), but whitelist model checkpoints
*.pkl
!models/checkpoints/*.pkl
!models/checkpoints/*.txt

# Large deep learning weights (>100MB exceeds GitHub limits)
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.bin
*.pt
*.pth
*.bin

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS & Caches
.DS_Store
Thumbs.db
.matplotlib/
dist/
*.zip

# Jupyter
.ipynb_checkpoints/

# Kaggle
kaggle.json
